{
  "sources": [
    "src"
  ],
  "test_roots": [
    "src/tests.zig"
  ],
  "test_support": [
    "src/testing/**"
  ],
  "test_dependencies": [
    "shakedown",
    "other_aegis"
  ],
  "function_exceptions": {},
  "layout_exceptions": {},
  "docs": {
    "zig build docs -- declare": {
      "source": "examples/usage.zig",
      "region": "declare",
      "imports": [
        "ensign",
        "aegis"
      ]
    },
    "zig build docs -- main": {
      "source": "examples/usage.zig",
      "region": "main",
      "imports": [
        "ensign"
      ]
    },
    "zig build docs -- handled": {
      "source": "examples/usage.zig",
      "region": "handled",
      "imports": [
        "ensign"
      ]
    },
    "zig build docs -- completer": {
      "source": "examples/usage.zig",
      "region": "completer",
      "imports": [
        "ensign"
      ]
    },
    "zig build docs -- man": {
      "source": "examples/usage.zig",
      "region": "man",
      "imports": [
        "ensign"
      ]
    }
  },
  "extra_checks": [
    [
      "zig",
      "build",
      "check-consumer"
    ],
    [
      "zig",
      "build",
      "check-freestanding"
    ]
  ],
  "glint": {
    "rules": [
      {"id": "P003", "level": "gate"},
      {"id": "Z026", "level": "gate"},
      {"id": "A001", "level": "gate"},
      {"id": "A002", "level": "gate"},
      {"id": "A003", "level": "gate"},
      {"id": "A004", "level": "gate"},
      {"id": "A005", "level": "gate"}
    ]
  },
  "glint_paths": [
    "src",
    "bench",
    "examples",
    "ci",
    "build.zig"
  ]
}
